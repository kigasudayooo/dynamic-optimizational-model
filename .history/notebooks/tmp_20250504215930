# ## 8. 数値計算の効率化とパフォーマンス最適化
# 
# 動学最適化モデルの数値計算は計算量が多く、特に状態空間や行動空間が大きい場合は実行時間が長くなります。ここでは、計算の効率化と最適化のいくつかの方法を試してみましょう。

# In[12]:


def compare_grid_sizes_and_tolerances():
    """グリッドサイズと収束許容誤差が実行時間と精度に与える影響を比較"""
    
    # テストするグリッドサイズと収束許容誤差
    grid_sizes = [20, 50, 100, 200]
    tolerances = [1e-3, 1e-5, 1e-7]
    
    # 結果を保存する辞書
    results = {}
    
    for n_states in grid_sizes:
        results[n_states] = {}
        
        for tol in tolerances:
            print(f"グリッドサイズ: {n_states}, 収束許容誤差: {tol}")
            
            # モデルを作成
            model = StochasticGrowthModel(
                n_states=n_states,
                tolerance=tol
            )
            
            # 値関数反復法での解法時間を計測
            start_time = time.time()
            _, _, policy_values, ss_k = model.solve(method='value_iteration', verbose=False)
            vi_time = time.time() - start_time
            
            # 政策反復法での解法時間を計測
            start_time = time.time()
            _, _, _, _ = model.solve(method='policy_iteration', verbose=False)
            pi_time = time.time() - start_time
            
            # 理論的な定常状態との誤差
            error = abs(ss_k - model.theoretical_steady_state) / model.theoretical_steady_state
            
            # 結果を保存
            results[n_states][tol] = {
                'value_iteration_time': vi_time,
                'policy_iteration_time': pi_time,
                'relative_error': error,
                'vi_iterations': len(model.iterations_history[0][0])
            }
    
    # 結果の可視化
    fig, axes = plt.subplots(2, 2, figsize=(16, 12))
    
    # 値関数反復法の実行時間
    for tol in tolerances:
        times = [results[n][tol]['value_iteration_time'] for n in grid_sizes]
        axes[0, 0].plot(grid_sizes, times, 'o-', label=f'tol={tol}')
    
    axes[0, 0].set_xlabel('グリッドサイズ')
    axes[0, 0].set_ylabel('実行時間 (秒)')
    axes[0, 0].set_title('値関数反復法の実行時間')
    axes[0, 0].grid(True, alpha=0.3)
    axes[0, 0].legend()
    
    # 政策反復法の実行時間
    for tol in tolerances:
        times = [results[n][tol]['policy_iteration_time'] for n in grid_sizes]
        axes[0, 1].plot(grid_sizes, times, 'o-', label=f'tol={tol}')
    
    axes[0, 1].set_xlabel('グリッドサイズ')
    axes[0, 1].set_ylabel('実行時間 (秒)')
    axes[0, 1].set_title('政策反復法の実行時間')
    axes[0, 1].grid(True, alpha=0.3)
    axes[0, 1].legend()
    
    # 相対誤差
    for tol in tolerances:
        errors = [results[n][tol]['relative_error'] for n in grid_sizes]
        axes[1, 0].plot(grid_sizes, errors, 'o-', label=f'tol={tol}')
    
    axes[1, 0].set_xlabel('グリッドサイズ')
    axes[1, 0].set_ylabel('相対誤差')
    axes[1, 0].set_title('定常状態の理論値との相対誤差')
    axes[1, 0].grid(True, alpha=0.3)
    axes[1, 0].set_yscale('log')
    axes[1, 0].legend()
    
    # 反復回数
    for tol in tolerances:
        iters = [results[n][tol]['vi_iterations'] for n in grid_sizes]
        axes[1, 1].plot(grid_sizes, iters, 'o-', label=f'tol={tol}')
    
    axes[1, 1].set_xlabel('グリッドサイズ')
    axes[1, 1].set_ylabel('反復回数')
    axes[1, 1].set_title('値関数反復法の収束までの反復回数')
    axes[1, 1].grid(True, alpha=0.3)
    axes[1, 1].legend()
    
    plt.tight_layout()
    plt.show()
    
    return results


