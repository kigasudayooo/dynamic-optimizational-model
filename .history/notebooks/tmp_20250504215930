# ### ベクトル化による高速化

# In[14]:


class OptimizedGrowthModel(StochasticGrowthModel):
    """ベクトル化操作によって最適化された成長モデル"""
    
    def bellman_operator_vectorized(self, v: np.ndarray) -> np.ndarray:
        """ベクトル化されたベルマンオペレータ"""
        n_states = len(self.state_grid)
        n_actions = len(self.action_grid)
        
        # 状態と行動の全ての組み合わせについて報酬を計算
        # shape: (n_states, n_actions)
        states_grid = self.state_grid[:, np.newaxis]
        actions_grid = self.action_grid[np.newaxis, :]
        
        # 消費を計算: c = f(k) + (1-δ)k - k'
        consumption = (self.z * states_grid ** self.alpha + 
                      (1 - self.delta) * states_grid - 
                      actions_grid)
        
        # 実行可能な消費のみ有効（消費が正）
        feasible = consumption > 0
        
        # 報酬を計算: u(c) = log(c)
        rewards = np.zeros((n_states, n_actions))
        rewards[feasible] = np.log(consumption[feasible])
        rewards[~feasible] = -np.inf
        
        # 将来価値の期待値（決定論的モデルの場合）
        # 各行動に対応する次期状態のインデックスを見つける
        action_indices = np.searchsorted(self.state_grid, self.action_grid)
        # 範囲外の値を修正（最大インデックスを超えないように）
        action_indices = np.minimum(action_indices, n_states - 1)
        
        # 将来価値の計算
        future_values = self.discount_factor * v[action_indices]
        
        # 合計値（現在の報酬 + 割引将来価値）
        total_values = rewards + future_values[np.newaxis, :]
        
        # 各状態での最大値を取得
        Tv = np.max(total_values, axis=1)
        
        # 最適政策の更新
        self.policy = np.argmax(total_values, axis=1)
        
        return Tv
    
    def value_iteration_optimized(self, verbose=True) -> Tuple[np.ndarray, np.ndarray]:
        """最適化された値関数反復法"""
        v = np.zeros_like(self.state_grid)
        
        # 反復回数とエラー履歴を保存するリスト
        iterations = []
        errors = []
        
        start_time = time.time()
        
        for i in range(self.max_iter):
            v_new = self.bellman_operator_vectorized(v)
            
            # 収束判定
            error = np.max(np.abs(v_new - v))
            iterations.append(i + 1)
            errors.append(error)
            
            if error < self.tolerance:
                if verbose:
                    elapsed_time = time.time() - start_time
                    print(f"Optimized value iteration converged in {i+1} iterations in {elapsed_time:.3f} seconds.")
                break
                
            v = v_new
            
        if i == self.max_iter - 1 and verbose:
            print(f"Warning: Optimized value iteration did not converge within {self.max_iter} iterations.")
            
        self.value_function = v
        self.iterations_history = [(iterations, errors)]
        return self.value_function, self.policy
    
    def compare_standard_vs_optimized(self):
        """標準実装と最適化実装の実行時間を比較"""
        # 標準実装（元のbellman_operator使用）
        start_time = time.time()
        v_standard, p_standard = self.value_iteration(verbose=False)
        standard_time = time.time() - start_time
        standard_iterations = len(self.iterations_history[0][0])
        
        # 最適化実装（ベクトル化されたbellman_operator使用）
        start_time = time.time()
        v_optimized, p_optimized = self.value_iteration_optimized(verbose=False)
        optimized_time = time.time() - start_time
        optimized_iterations = len(self.iterations_history[0][0])
        
        # 結果の表示
        print("\n実装の比較:")
        print(f"標準実装: {standard_time:.3f}秒, {standard_iterations}回の反復")
        print(f"最適化実装: {optimized_time:.3f}秒, {optimized_iterations}回の反復")
        print(f"高速化率: {standard_time / optimized_time:.1f}倍")
        
        # 結果の一致確認
        value_diff = np.max(np.abs(v_standard - v_optimized))
        policy_diff = np.sum(p_standard != p_optimized)
        
        print(f"\n結果の差異:")
        print(f"値関数の最大差: {value_diff:.8f}")
        print(f"政策の差異数: {policy_diff}/{len(p_standard)}")
        
        return {
            'standard_time': standard_time,
            'optimized_time': optimized_time,
            'speedup': standard_time / optimized_time,
            'value_diff': value_diff,
            'policy_diff': policy_diff
        }


